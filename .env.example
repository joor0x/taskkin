# Environment configuration
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://taskkin:taskkin_secure_pass@localhost:5433/taskkin

# Redis
REDIS_URL=redis://localhost:6380/0

# JWT Settings
JWT_SECRET=super_secret_jwt_key_for_development_purposes_only_123456
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=taskkin-evidence
MINIO_SECURE=false

# Webhooks
ALLOW_LOCALHOST_WEBHOOKS=true
